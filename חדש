<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>חמ"ל סייבר - מרכז הגנה ואקדמיית אבטחה (15 שלבים)</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tone.js for Audio Synth -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;600;700;900&family=Share+Tech+Mono&display=swap');
        
        body {
            font-family: 'Rubik', sans-serif;
            background-color: #050b14;
            color: #00ffcc;
            overflow-x: hidden;
        }
        
        .code-font {
            font-family: 'Share Tech Mono', monospace;
        }

        .cyber-border {
            border: 1px solid #00ffcc;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.2);
        }

        .cyber-card {
            background: rgba(10, 25, 47, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(0, 255, 204, 0.3);
        }

        .cyber-button {
            background: linear-gradient(135deg, #0055ff, #00ffcc);
            color: #000;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        .cyber-button:hover {
            box-shadow: 0 0 20px rgba(0, 255, 204, 0.6);
            transform: translateY(-2px);
        }

        /* Red Alarm Pulse Overlay */
        @keyframes red-alarm-pulse {
            0% { box-shadow: inset 0 0 0px #ff0055; border-color: #ff0055; }
            50% { box-shadow: inset 0 0 50px #ff0055; border-color: #ff0055; background-color: rgba(255, 0, 85, 0.15); }
            100% { box-shadow: inset 0 0 0px #ff0055; border-color: #ff0055; }
        }

        .alarm-red-flash {
            animation: red-alarm-pulse 0.4s ease-in-out 3;
            border-color: #ff0055 !important;
        }

        /* Certificate Print Styling */
        @media print {
            body * {
                visibility: hidden;
            }
            #certificate-modal, #certificate-modal * {
                visibility: visible;
            }
            #certificate-modal {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative text-gray-100 selection:bg-cyan-500 selection:text-black">

    <!-- Header / Cyber Status Bar -->
    <header class="w-full bg-slate-950/90 border-b border-cyan-500/30 p-4 sticky top-0 z-40 backdrop-blur-md">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3 space-x-reverse">
                <i class="fa-solid fa-shield-halved text-2xl text-cyan-400 animate-pulse"></i>
                <h1 class="text-xl font-bold tracking-wider text-cyan-400">חמ"ל סייבר <span class="text-xs px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-500/40">15 שלבים</span></h1>
            </div>
            
            <div class="flex items-center gap-4 md:gap-6">
                <div class="hidden md:flex items-center gap-2">
                    <span class="text-xs text-gray-400">לוחם/ת סייבר:</span>
                    <span id="player-display-name" class="font-bold text-yellow-400">אורח</span>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-400"></i>
                    <span class="text-xs text-gray-400">ניקוד:</span>
                    <span id="score-display" class="font-bold text-amber-400 code-font text-lg">0</span>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-layer-group text-cyan-400"></i>
                    <span class="text-xs text-gray-400">שלב:</span>
                    <span id="stage-display" class="font-bold text-cyan-400 code-font">1/15</span>
                </div>
                <!-- Admin Panel Button -->
                <button onclick="openAdminAuth()" class="px-3 py-1 rounded bg-slate-900 border border-cyan-500/50 hover:bg-cyan-950 text-xs text-cyan-300 font-bold flex items-center gap-1">
                    <i class="fa-solid fa-gear"></i> פאנל ניהול
                </button>
            </div>
        </div>
    </header>

    <!-- Main Game Container -->
    <main id="main-container" class="max-w-5xl mx-auto w-full p-4 md:p-8 flex-grow flex flex-col justify-center">

        <!-- Welcome / Registration View -->
        <div id="view-welcome" class="cyber-card p-6 md:p-10 rounded-2xl cyber-border text-center">
            <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-cyan-950/80 border-2 border-cyan-400 flex items-center justify-center">
                <i class="fa-solid fa-user-shield text-4xl text-cyan-400"></i>
            </div>
            <h2 class="text-3xl font-black mb-3 text-white">כניסה למערכת פיקוד הסייבר - 15 שלבים</h2>
            <p class="text-gray-300 max-w-xl mx-auto mb-6 text-sm md:text-base">
                עבור 15 שלבי אימון אינטראקטיביים בזמן אמת: מניעת פישינג, סינון חומת אש, אבטחת USB, הגנת Deepfake, חסימת DDoS ותגובה לאירוע כופרה. להשגת תעודת מוסמך סייבר בכיר!
            </p>

            <form id="start-form" onsubmit="startGame(event)" class="max-w-md mx-auto space-y-4">
                <div>
                    <label class="block text-right text-xs text-cyan-400 mb-1 font-bold">שם מלא (יופיע על התעודה בסיום):</label>
                    <input type="text" id="player-name-input" required placeholder="הכנס את שמך מלא..." 
                           class="w-full bg-slate-900 border border-cyan-500/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-cyan-400 text-center text-lg">
                </div>
                <button type="submit" class="w-full py-4 rounded-xl cyber-button text-black font-black text-lg tracking-wider flex items-center justify-center gap-2">
                    <i class="fa-solid fa-power-off"></i> התחל במשימה (15 שלבים)
                </button>
            </form>
        </div>

        <!-- Gameplay Screen -->
        <div id="view-gameplay" class="hidden space-y-6">
            
            <!-- Stage Header Info -->
            <div class="cyber-card p-4 rounded-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span id="stage-badge" class="px-2.5 py-1 text-xs font-bold rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">שלב 1</span>
                        <h3 id="stage-title" class="text-xl font-bold text-white">תחקור פישינג</h3>
                    </div>
                    <p id="stage-desc" class="text-xs text-gray-400 mt-1">נתח את ההודעות הנכנסות וזהה איומים בזמן אמת.</p>
                </div>
                <!-- Accessibility Badge -->
                <div id="accessibility-status" class="px-3 py-1.5 rounded-lg border text-xs font-bold flex items-center gap-2 bg-slate-900 border-gray-700 text-gray-300">
                    <i class="fa-solid fa-eye"></i>
                    <span>חיווי נגישות מופעל [✓ נכון / ✗ לא נכון]</span>
                </div>
            </div>

            <!-- Dynamic Interactive Workspace -->
            <div id="stage-workspace" class="cyber-card p-6 rounded-2xl min-h-[350px] relative flex flex-col justify-between">
                <!-- Content injected dynamically via JavaScript -->
            </div>

            <!-- Live Terminal / Cyber Command Log -->
            <div class="bg-black/80 rounded-xl p-4 border border-cyan-900 code-font text-xs space-y-1">
                <div class="text-gray-500 flex justify-between border-b border-gray-800 pb-1 mb-2">
                    <span><i class="fa-solid fa-terminal"></i> יומן אירועי חמ"ל (CYBER LOG)</span>
                    <span class="text-cyan-500">LIVE FEED</span>
                </div>
                <div id="terminal-log" class="space-y-1 max-h-24 overflow-y-auto">
                    <div class="text-cyan-400">> המערכת מוכנה. ממתין לפעולות המשתמש...</div>
                </div>
            </div>
        </div>

        <!-- Final Certificate View -->
        <div id="view-certificate" class="hidden">
            <div id="certificate-modal" class="cyber-card p-8 md:p-12 rounded-2xl border-4 border-amber-400/80 text-center space-y-6 relative overflow-hidden bg-slate-950">
                <div class="w-24 h-24 mx-auto rounded-full bg-amber-500/10 border-2 border-amber-400 flex items-center justify-center">
                    <i class="fa-solid fa-award text-5xl text-amber-400"></i>
                </div>
                <div>
                    <h2 class="text-xs tracking-widest text-amber-400 uppercase font-bold mb-1">תעודת הסמכה רשמית</h2>
                    <h1 class="text-3xl md:text-4xl font-black text-white">מוסמך אבטחת מידע וסייבר בכיר (15/15)</h1>
                </div>
                <p class="text-gray-300">תעודה זו מוצגת בזאת לאות הערכה ל-</p>
                <div id="cert-user-name" class="text-3xl font-black text-cyan-400 border-b-2 border-cyan-400/50 inline-block px-8 py-2">שם השחקן</div>
                <p class="text-sm text-gray-300 max-w-lg mx-auto">
                    על סיום בהצלחה של 15 שלבי אימון מתקדמים בחמ"ל הסייבר, ניתוח פישינג, סינון חומת אש, הגנת Deepfake, אבטחת USB, חסימת DDoS ותגובה לאירועי כופרה.
                </p>
                
                <div class="grid grid-cols-2 max-w-md mx-auto gap-4 py-4 text-right bg-slate-900/80 p-4 rounded-xl border border-gray-800 text-xs">
                    <div><span class="text-gray-400">ציון סופי:</span> <span id="cert-score" class="font-bold text-amber-400">0</span></div>
                    <div><span class="text-gray-400">דרגת הסמכה:</span> <span id="cert-rank" class="font-bold text-cyan-400">מומחה הגנת סייבר בכיר</span></div>
                    <div><span class="text-gray-400">תאריך הנפקה:</span> <span id="cert-date" class="font-bold text-gray-200">-</span></div>
                    <div><span class="text-gray-400">אימות מערכת:</span> <span class="font-bold text-green-400 code-font">PASSED [15/15]</span></div>
                </div>

                <div class="flex flex-wrap justify-center gap-4 pt-4 no-print">
                    <button onclick="window.print()" class="px-6 py-3 rounded-xl bg-amber-500 text-black font-bold hover:bg-amber-400 flex items-center gap-2">
                        <i class="fa-solid fa-print"></i> הדפס / שמור כ-PDF
                    </button>
                    <button onclick="location.reload()" class="px-6 py-3 rounded-xl bg-gray-800 text-white font-bold hover:bg-gray-700 flex items-center gap-2">
                        <i class="fa-solid fa-rotate-right"></i> התחל משחק חדש
                    </button>
                </div>
            </div>
        </div>

        <!-- ADMIN DASHBOARD VIEW -->
        <div id="view-admin" class="hidden space-y-6">
            <div class="cyber-card p-6 rounded-2xl border border-cyan-400 space-y-6">
                <div class="flex justify-between items-center border-b border-gray-800 pb-4">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-chart-line text-2xl text-cyan-400"></i>
                        <h2 class="text-2xl font-bold text-white">פאנל ניהול ומעקב נתונים (Admin Analytics)</h2>
                    </div>
                    <button onclick="closeAdminPanel()" class="px-4 py-1.5 rounded bg-gray-800 text-xs text-white hover:bg-gray-700">יציאה מפאנל מנהל</button>
                </div>

                <!-- Key Metrics Grid -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="bg-slate-900 p-4 rounded-xl border border-gray-800 text-center">
                        <span class="text-xs text-gray-400 block mb-1">סה"כ משתתפים</span>
                        <span id="admin-total-players" class="text-2xl font-black text-cyan-400 code-font">0</span>
                    </div>
                    <div class="bg-slate-900 p-4 rounded-xl border border-gray-800 text-center">
                        <span class="text-xs text-gray-400 block mb-1">ניקוד נוכחי</span>
                        <span id="admin-avg-score" class="text-2xl font-black text-amber-400 code-font">0</span>
                    </div>
                    <div class="bg-slate-900 p-4 rounded-xl border border-gray-800 text-center">
                        <span class="text-xs text-gray-400 block mb-1">אחוז התקדמות</span>
                        <span id="admin-completion-rate" class="text-2xl font-black text-green-400 code-font">0%</span>
                    </div>
                    <div class="bg-slate-900 p-4 rounded-xl border border-gray-800 text-center">
                        <span class="text-xs text-gray-400 block mb-1">סה"כ שגיאות</span>
                        <span id="admin-total-errors" class="text-2xl font-black text-red-400 code-font">0</span>
                    </div>
                </div>

                <!-- Logs Table -->
                <div class="space-y-2">
                    <h3 class="text-sm font-bold text-cyan-400">יומן פעילות בזמן אמת:</h3>
                    <div class="bg-slate-950 border border-gray-800 rounded-xl p-4 max-h-60 overflow-y-auto font-mono text-xs text-gray-300 space-y-1" id="admin-log-list">
                        <div class="text-gray-500">ממתין לתחילת פעילות משתמש...</div>
                    </div>
                </div>

                <div class="flex justify-between items-center text-xs pt-4 border-t border-gray-800">
                    <span class="text-gray-400">סיסמת מנהל: <code>admin123</code></span>
                    <button onclick="clearAnalytics()" class="px-3 py-1.5 rounded bg-red-950 border border-red-500 text-red-200 hover:bg-red-900">איפוס נתונים</button>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer with Terms & Cookies Banner -->
    <footer class="w-full bg-slate-950 border-t border-cyan-900/50 p-4 text-xs text-gray-400">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-2">
            <div>
                © 2026 חמ"ל סייבר ארגוני - מיועד להטמעה ב-Google Sites
            </div>
            <div class="flex gap-4">
                <button onclick="toggleModal('terms-modal')" class="underline hover:text-cyan-400 font-bold">תנאי שימוש ומדיניות פרטיות</button>
                <button onclick="toggleModal('cookies-modal')" class="underline hover:text-cyan-400">מדיניות עוגיות (Cookies)</button>
            </div>
        </div>
    </footer>

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:max-w-md bg-slate-900 border border-cyan-500 rounded-xl p-4 z-50 shadow-2xl flex flex-col gap-3">
        <div class="flex items-start gap-3">
            <i class="fa-solid fa-cookie-bite text-2xl text-amber-400 mt-1"></i>
            <div class="text-xs text-gray-300">
                <strong class="text-white block mb-1">הודעת עוגיות ופרטיות (Cookies)</strong>
                משחק זה משתמש באחסון מקומי בדפדפן (Local Storage) לשמירת התקדמות השחקנים והניקוד בלבד.
            </div>
        </div>
        <div class="flex justify-end gap-2 text-xs">
            <button onclick="acceptCookies()" class="px-4 py-1.5 rounded cyber-button text-black font-bold">אישור והבנתי</button>
        </div>
    </div>

    <!-- Modal Terms & Conditions -->
    <div id="terms-modal" class="fixed inset-0 bg-black/85 hidden items-center justify-center z-50 p-4">
        <div class="cyber-card p-6 md:p-8 rounded-xl max-w-2xl w-full space-y-4 max-h-[85vh] overflow-y-auto text-right">
            <h3 class="text-xl font-bold text-cyan-400 border-b border-gray-800 pb-2">תנאי שימוש ותקנון פרטיות</h3>
            
            <div class="space-y-3 text-xs text-gray-300 leading-relaxed">
                <p><strong>1. מהות המערכת:</strong><br>
                מערכת "חמ"ל סייבר" הינה סימולטור אימונים אינטראקטיבי המיועד למטרות לימודיות, הדרכתיות ולהעלאת המודעות לאבטחת מידע.</p>

                <p><strong>2. שימוש מותר:</strong><br>
                כל התרחישים, השאלות והתכנים הינם סימולציות מוגנות בתוך סביבה מבוקרת. אין לעשות שימוש בתכנים למטרות פריצה או תקיפה שאינה חוקית.</p>

                <p><strong>3. הגנת פרטיות ואחסון נתונים:</strong><br>
                המשחק אינו אוסף או מעביר מידע אישי לשרתים חיצוניים. כל הנתונים (שם השחקן/ית והניקוד) נשמרים מקומית בדפדפן המשתמש (Local Storage) בלבד.</p>
            </div>

            <div class="text-left pt-4 border-t border-gray-800">
                <button onclick="toggleModal('terms-modal')" class="px-5 py-2 rounded bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold">אישור וסגירה</button>
            </div>
        </div>
    </div>

    <!-- Modal Cookies -->
    <div id="cookies-modal" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50 p-4">
        <div class="cyber-card p-6 rounded-xl max-w-lg w-full space-y-4">
            <h3 class="text-lg font-bold text-cyan-400">מדיניות עוגיות וטכנולוגיות אחסון</h3>
            <p class="text-xs text-gray-300 leading-relaxed">
                אנו משתמשים ב-LocalStorage בדפדפן לשם שמירת שם השחקן/ית וההתקדמות בלבד.
            </p>
            <div class="text-left">
                <button onclick="toggleModal('cookies-modal')" class="px-4 py-2 rounded bg-cyan-600 text-white text-xs font-bold">סגור</button>
            </div>
        </div>
    </div>

    <!-- Game Logic JavaScript -->
    <script>
        var gameState = {
            playerName: '',
            score: 0,
            currentStage: 1,
            maxStages: 15,
            errorsCount: 0,
            logs: []
        };

        function playSound(type) {
            try {
                if (typeof Tone !== 'undefined') {
                    if (Tone.context.state !== 'running') Tone.start();
                    var synth = new Tone.Synth().toDestination();
                    if (type === 'success') synth.triggerAttackRelease("C5", "8n");
                    else if (type === 'error') synth.triggerAttackRelease("G2", "8n");
                }
            } catch (e) {}
        }

        function startGame(e) {
            e.preventDefault();
            var input = document.getElementById('player-name-input');
            if (!input || !input.value.trim()) return;
            
            gameState.playerName = input.value.trim();
            document.getElementById('player-display-name').innerText = gameState.playerName;
            
            document.getElementById('view-welcome').classList.add('hidden');
            document.getElementById('view-gameplay').classList.remove('hidden');
            
            logTerminal("משתמש/ת " + gameState.playerName + " התחבר/ה למערכת. מתחיל 15 שלבים.");
            recordAdminLog("התחלת משחק: " + gameState.playerName);
            loadStage(1);
        }

        function logTerminal(msg) {
            var container = document.getElementById('terminal-log');
            if (!container) return;
            var entry = document.createElement('div');
            entry.className = "text-cyan-300";
            entry.innerText = "> " + msg;
            container.appendChild(entry);
            container.scrollTop = container.scrollHeight;
        }

        function triggerRedAlarm() {
            gameState.errorsCount++;
            var ws = document.getElementById('stage-workspace');
            if (ws) {
                ws.classList.add('alarm-red-flash');
                playSound('error');
                setTimeout(function() { ws.classList.remove('alarm-red-flash'); }, 1200);
            }
        }

        function addScore(points) {
            gameState.score += points;
            document.getElementById('score-display').innerText = gameState.score;
        }

        function acceptCookies() {
            document.getElementById('cookie-banner').classList.add('hidden');
        }

        function toggleModal(id) {
            var el = document.getElementById(id);
            if (el.classList.contains('hidden')) {
                el.classList.remove('hidden');
                el.classList.add('flex');
            } else {
                el.classList.add('hidden');
                el.classList.remove('flex');
            }
        }

        function openAdminAuth() {
            var pass = prompt("הכנס קוד גישה למנהל (Default: admin123):");
            if (pass === "admin123") {
                document.getElementById('view-welcome').classList.add('hidden');
                document.getElementById('view-gameplay').classList.add('hidden');
                document.getElementById('view-certificate').classList.add('hidden');
                document.getElementById('view-admin').classList.remove('hidden');
                updateAdminDashboard();
            } else if (pass !== null) {
                alert("קוד גישה שגוי!");
            }
        }

        function closeAdminPanel() {
            document.getElementById('view-admin').classList.add('hidden');
            if (gameState.playerName) {
                document.getElementById('view-gameplay').classList.remove('hidden');
            } else {
                document.getElementById('view-welcome').classList.remove('hidden');
            }
        }

        function recordAdminLog(msg) {
            var time = new Date().toLocaleTimeString('he-IL');
            gameState.logs.push("[" + time + "] " + msg);
        }

        function updateAdminDashboard() {
            document.getElementById('admin-total-players').innerText = gameState.playerName ? 1 : 0;
            document.getElementById('admin-avg-score').innerText = gameState.score;
            document.getElementById('admin-total-errors').innerText = gameState.errorsCount;

            var completion = Math.round(((gameState.currentStage - 1) / gameState.maxStages) * 100);
            document.getElementById('admin-completion-rate').innerText = completion + "%";

            var logContainer = document.getElementById('admin-log-list');
            if (gameState.logs.length > 0) {
                logContainer.innerHTML = gameState.logs.map(function(l) { return "<div>> " + l + "</div>"; }).join('');
            }
        }

        function clearAnalytics() {
            gameState.logs = [];
            gameState.errorsCount = 0;
            updateAdminDashboard();
            alert("נתוני המעקב אופסו בהצלחה.");
        }

        function loadStage(stageNum) {
            gameState.currentStage = stageNum;
