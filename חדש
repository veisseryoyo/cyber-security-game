            if (opt === 2) { playSound('success'); addScore(200); logTerminal("נכון! הגבלת הרשאות בענן מונעת זליגת מידע חסוי."); loadStage(14); }
            else { triggerRedAlarm(); document.getElementById('feedback-area-13').innerHTML = '<div class="p-3 bg-red-900/40 border border-red-500 text-red-200 rounded-lg"><strong>[ ✗ לא נכון ]</strong> קישור ציבורי פתוח עלול להגיע לגורמים עוינים ולדלוא מידע!</div>'; }
        }

        function renderStage14(container) {
            document.getElementById('stage-title').innerText = '14. זיהוי עוקץ Deepfake מבוסס AI';
            document.getElementById('stage-desc').innerText = 'התקבלה הודעת קול ב-WhatsApp מהמנכ"ל המבקש העברת כספים דחופה לחו"ל. מה עליך לעשות?';
            container.innerHTML = '<div class="space-y-4">' +
                '<div class="bg-slate-900 p-4 rounded-xl border border-gray-700 text-xs">' +
                    'הודעה קולית: "שלום, מדבר המנכ"ל. אני בפגישה סודית, תעביר 50,000$ לחשבון בחו"ל עכשיו."' +
                '</div>' +
                '<div class="space-y-2 text-xs md:text-sm">' +
                    '<button onclick="checkStage14(1)" class="w-full text-right p-3 rounded-lg bg-slate-900 border border-gray-700 hover:border-cyan-500">1. לבצע את ההעברה מיד כדי לא להכעיס את המנכ"ל.</button>' +
                    '<button onclick="checkStage14(2)" class="w-full text-right p-3 rounded-lg bg-slate-900 border border-gray-700 hover:border-cyan-500">2. לעצור ולבצע אימות טלפוני בערוץ רשמי נפרד (Out-of-Band Verification).</button>' +
                '</div>' +
                '<div id="feedback-area-14"></div>' +
            '</div>';
        }
        function checkStage14(opt) {
            if (opt === 2) { playSound('success'); addScore(250); logTerminal("נכון מאוד! קולות AI זמינים להאקרים. חובה לאמת בערוץ משני."); loadStage(15); }
            else { triggerRedAlarm(); document.getElementById('feedback-area-14').innerHTML = '<div class="p-3 bg-red-900/40 border border-red-500 text-red-200 rounded-lg"><strong>[ ✗ לא נכון ]</strong> זיוף קול (Deepfake) נפוץ מאוד בהונאות מנכ"ל!</div>'; }
        }

        function renderStage15(container) {
            document.getElementById('stage-title').innerText = '15. מבחן הסמכה מסכם: ניהול אירוע משולב (Master Test)';
            document.getElementById('stage-desc').innerText = 'קבע את רצף התגובה הנכון בטיפול באירוע פריצה מורכב בארגון.';
            container.innerHTML = '<div class="space-y-4">' +
                '<div class="bg-slate-900 p-4 rounded-xl border border-cyan-400 text-xs">' +
                    'תרחיש: התגלתה פריצה למערכת השכר במקביל למייל פישינג שנשלח לכל העובדים.' +
                '</div>' +
                '<div class="space-y-2 text-xs md:text-sm">' +
                    '<button onclick="checkStage15(1)" class="w-full text-right p-3 rounded-lg bg-slate-900 border border-gray-700 hover:border-cyan-500">1. בידוד השרת -> חסימת דומיין הפישינג -> איפוס סיסמאות -> תחקור וגיבוי.</button>' +
                    '<button onclick="checkStage15(2)" class="w-full text-right p-3 rounded-lg bg-slate-900 border border-gray-700 hover:border-cyan-500">2. שליחת מייל לכולם בלבד והמשך עבודה כרגיל.</button>' +
                '</div>' +
                '<div id="feedback-area-15"></div>' +
            '</div>';
        }
        function checkStage15(opt) {
            if (opt === 1) { playSound('success'); addScore(300); logTerminal("כל הכבוד! השלמת בהצלחה את כל 15 שלבי ההסמכה בחמ"ל!"); recordAdminLog("סיום בהצלחה של כל 15 השלבים!"); loadStage(16); }
            else { triggerRedAlarm(); document.getElementById('feedback-area-15').innerHTML = '<div class="p-3 bg-red-900/40 border border-red-500 text-red-200 rounded-lg"><strong>[ ✗ לא נכון ]</strong> רצף התגובה הנכון הוא בידוד, חסימה, איפוס ותחקור!</div>'; }
        }

        function showCertificate() {
            document.getElementById('view-gameplay').classList.add('hidden');
            document.getElementById('view-certificate').classList.remove('hidden');

            document.getElementById('cert-user-name').innerText = gameState.playerName;
            document.getElementById('cert-score').innerText = gameState.score;
            document.getElementById('cert-date').innerText = new Date().toLocaleDateString('he-IL');

            var rank = 'מומחה הגנת סייבר בכיר (15/15)';
            if (gameState.score >= 2800) rank = 'מאסטר הגנת סייבר ארגונית (Chief Cyber Master)';
            document.getElementById('cert-rank').innerText = rank;

            playSound('success');
        }
    </script>
</body>
</html>
